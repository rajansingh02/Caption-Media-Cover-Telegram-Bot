API_ID=12345678
API_HASH=YOUR_API_HASH
BOT_TOKEN=YOUR_BOT_TOKEN
MAX_BATCH_SIZE=100
SESSION_NAME=caption_bot

# ---------------------------------------------------------------------
# Optional tuning. Every value below already defaults to the setting
# that suits small/low-RAM hardware, so the block can stay commented.
# ---------------------------------------------------------------------

# Pyrogram update workers. 1 is plenty for a single-user bot.
# WORKERS=1

# Parallel transfer slots. Nothing is ever up/downloaded, so 1 is fine.
# MAX_CONCURRENT_TRANSMISSIONS=1

# Quiet period (seconds) used to group an incoming media burst.
# COLLECTION_DELAY=2.5

# Gap (seconds) between files while /transfer resends a season.
# SEND_DELAY=1.2

# DEBUG | INFO | WARNING | ERROR. WARNING keeps console/disk I/O minimal.
# LOG_LEVEL=INFO

# Use uvloop when it is installed.
# USE_UVLOOP=true

# Keep the Pyrogram session in RAM (no session file writes; the peer
# cache is rebuilt on each restart).
# SESSION_IN_MEMORY=false

# Archive location and its SQLite page cache in KiB.
# DB_PATH=bot_data.sqlite3
# DB_CACHE_KIB=2048
